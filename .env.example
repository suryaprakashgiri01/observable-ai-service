# Copy to .env. Every key is optional: a model whose provider has no key is
# listed as unavailable, and the service still answers through `mock-echo`.

# --- service --------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=auto                 # json | console | auto (console on a TTY)
PORT=8000
ENABLE_FAULT_INJECTION=true     # honours X-Debug-Fault; keep false outside demos

# --- database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ai_service
# Fernet key for bring-your-own-model API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- LLM providers ----------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_DEFAULT_MODEL_ID=gpt-4.1-mini
LLM_FALLBACK_MODEL_ID=mock-echo
LLM_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=3

# --- tracing --------------------------------------------------------------
OTEL_SERVICE_NAME=observable-ai-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Langfuse (LLM traces) -------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- seed users (pin keys so demos are repeatable; blank = generate) -------
SEED_ADMIN_API_KEY=
SEED_DEMO_API_KEY=
